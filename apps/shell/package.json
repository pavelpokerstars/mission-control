{
  "name": "@mc/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@mc/domain": "*"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p apps/shell/tsconfig.json",
        "cache": true
      },
      "build": {
        "command": "vite build --config apps/shell/vite.config.mts",
        "cache": true,
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "serve": {
        "command": "vite --config apps/shell/vite.config.mts"
      }
    }
  }
}
